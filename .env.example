# Read by the server actions in app/actions.ts. Dashboard → Project settings →
# API keys. The project ref itself lives in trigger.config.ts.
TRIGGER_SECRET_KEY=tr_dev_xxxxxxxxxxxx

# Read by the local dev worker — `trigger dev` loads .env / .env.local /
# .env.development / .env.development.local. For deployed environments, set this
# in the dashboard under Environment Variables instead.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
